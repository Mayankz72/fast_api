GEMINI_API_KEY=
# Optional: a second account's key, dedicated to embeddings only, so its quota
# doesn't compete with generation/eval-judge quota on GEMINI_API_KEY. Falls back
# to GEMINI_API_KEY if unset.
GEMINI_API_KEY_EMBED=
GITHUB_TOKEN=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=fastapi_corpus
QDRANT_COLLECTION_LOCAL=fastapi_corpus_local
# gemini (default, rate-limited free tier) or local (offline sentence-transformers)
EMBED_BACKEND=gemini
