GEMINI_API_KEY=
# Optional: a second account's key, dedicated to embeddings only, so its quota
# doesn't compete with generation/eval-judge quota on GEMINI_API_KEY. Falls back
# to GEMINI_API_KEY if unset.
GEMINI_API_KEY_EMBED=
GITHUB_TOKEN=
QDRANT_URL=http://localhost:6333
# Only needed for Qdrant Cloud; leave unset for local Docker Qdrant.
QDRANT_API_KEY=
QDRANT_COLLECTION=fastapi_corpus
QDRANT_COLLECTION_LOCAL=fastapi_corpus_local
# gemini (default, rate-limited free tier) or local (offline sentence-transformers)
EMBED_BACKEND=gemini
# Optional cross-encoder reranking stage - see RESOURCES.md's v2-vs-v3 ablation
# before enabling: helps low-confidence retrievals but hurts already-good ones.
USE_RERANKER=false

# --- Only needed when running src/index/migrate_to_cloud.py to deploy ---
# Destination Qdrant Cloud cluster (separate from QDRANT_URL/QDRANT_API_KEY
# above, which the app itself reads - keeps "where points are copied from"
# and "where the deployed app reads from" independently configurable).
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=
